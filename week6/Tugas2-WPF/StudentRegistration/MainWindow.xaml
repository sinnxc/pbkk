<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration" Width="1240" Height="640"
        MinWidth="760" MinHeight="400" FontFamily="Segoe UI" FontSize="14"
        Background="#F5F5F5" Foreground="#202020"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Student Registration" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Daftar mahasiswa dan program studi" Foreground="#505050" Margin="0,5,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="_Refresh" Padding="22,10"
                    VerticalAlignment="Center" Click="RefreshButton_Click"
                    AutomationProperties.Name="Refresh" ToolTip="Ambil ulang data dari SQL Server (Alt+R)" />
        </Grid>
        <Grid Grid.Row="1">
            <DataGrid x:Name="StudentDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="38"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEDEDE"
                      Background="White" BorderBrush="#B0B0B0"
                      AlternatingRowBackground="#F3F5F3"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Daftar mahasiswa">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="55" />
                    <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="110" />
                    <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="160" />
                    <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramName}" Width="180" />
                    <DataGridTextColumn Header="Tanggal Lahir" Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="115" />
                    <DataGridTextColumn Header="No. Telepon" Binding="{Binding PhoneNumber}" Width="135" />
                    <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="250" />
                    <DataGridTextColumn Header="Dibuat" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="155" />
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyState" Background="White" Padding="20" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="Belum ada mahasiswa di database." Foreground="#505050" />
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#376645" BorderThickness="4,0,0,0" Padding="12,0,0,0" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="TotalText" Text="Total Mahasiswa: belum dimuat" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Menyiapkan koneksi SQL Server..." TextWrapping="Wrap"
                           Foreground="#505050" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
